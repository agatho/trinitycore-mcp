# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build output
dist/
build/
*.js.map
*.d.ts.map

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Logs
logs/
*.log

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.temp
.cache/

# Process management
*.pid

# Data files (optional - uncomment if not tracking data)
# data/
# *.dbc
# *.db2
# *.txt

# Extracted minimap tiles (cached)
cache/minimaps/
web-ui/public/maps/tiles/**/*.png

# Build-keyed spell caches. Generated from the active build's DB2 files by
# `npm run generate:spell-cache`, tens of megabytes per build, and reproducible
# from the client data, so they are kept out of the repository.
data/cache/*/spell_*cache.json
data/cache/*/spell_*cache.json.meta.json
# Lock held while a build's spell caches are being generated.
data/cache/*/.spell-cache-generating
