  "meta": {
    "created": "2026-08-20",
    "builds": "12.1.0.69214 .. 12.1.0.69382",
    "what": "catalog opcode value -> value on the 12.1 wire: family channel shift PLUS within-family index offsets",
    "formula": "client = ((catalog_family + family_shift) << 16) | (catalog_index + index_offset)",
    "provenance_codes": {
      "wire": "monotone injective direction-preserving assignment of 1,058,913 sniffed packets (11 sniffs, builds 69273/69299/69382) against WowPacketParser V12_0_7_67808",
      "jam": "the client's own WowGetRawTypeName<struct Jam...> strings in 12.1.0.69382",
      "interp": "forced: the shift is monotone non-decreasing and both neighbouring families are proven with the same shift",
      "ambiguous": "two shifts remain possible -- deliberately not mapped"
    },
    "index_offset_note": "null in an index range means the offset could not be decided; catalog_to_client returns None there so nothing is named wrongly",
